{
  "name": "newtab-extension",
  "version": "26.5.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bash scripts/build.sh",
    "check": "biome check src scripts tests *.json",
    "lint": "biome lint src scripts tests *.json",
    "format": "biome format --write src scripts tests *.json",
    "test": "node --test",
    "test:sync-e2e": "node scripts/run-browser-sync-e2e.mjs",
    "clean:safari-registrations": "node scripts/clean-safari-homepage-registrations.mjs",
    "sync-server": "node scripts/sync-server.mjs",
    "test:browser-smoke": "node scripts/run-browser-smoke.mjs",
    "test:firefox-persistence": "node scripts/run-firefox-persistence.mjs",
    "test:firefox-sync-ui": "node scripts/run-firefox-sync-ui.mjs",
    "test:firefox-sync-flows": "node scripts/run-firefox-sync-flows.mjs",
    "test:firefox-sync-errors": "node scripts/run-firefox-sync-errors.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4"
  }
}
